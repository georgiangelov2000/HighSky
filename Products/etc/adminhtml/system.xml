<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="highsky_products">
            <group id="product_sync" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Product</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Product Synchronisation Enabled</label>
                    <comment><![CDATA[
                        <strong>Yes</strong> — the <code>/rest/V1/highsky/sync/products</code> endpoint is active and returns the product catalogue according to the selected API columns.<br/>
                        <strong>No</strong> — the endpoint returns <code>403 Forbidden</code>. No product data is exposed regardless of authentication state.
                    ]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="default_per_page" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Default Products Per Page</label>
                    <comment><![CDATA[
                        Number of products returned when the API caller does not provide a <code>per_page</code> query parameter. Default is <strong>200</strong>.
                    ]]></comment>
                    <validate>required-entry validate-number validate-greater-than-zero</validate>
                </field>
                <field id="max_per_page" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Maximum Products Per Page</label>
                    <comment><![CDATA[
                        Hard ceiling for the <code>per_page</code> query parameter. Requests above this value are capped instead of loading larger datasets. Default is <strong>200</strong>.
                    ]]></comment>
                    <validate>required-entry validate-number validate-greater-than-zero</validate>
                </field>
            </group>
            <group id="api_columns" translate="label" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Product API Columns</label>
                <field id="enabled_columns" translate="label comment" type="multiselect" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled Columns</label>
                    <comment>Select which columns should be included in the product synchronisation API response.</comment>
                    <source_model>HighSky\Products\Model\Config\ProductSync\Source\AvailableColumns</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
